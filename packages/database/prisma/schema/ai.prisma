// AI assistant (docs/ai-assistant.md): a doctor-reviewed drafting aid. It summarises a patient's earlier signed visits and drafts plain-language advice for the doctor to
// edit. It never diagnoses, never prescribes, never writes to the chart by itself and is off until the hospital connects its own provider and confirms the data sharing.

enum AiProviderKind {
  ANTHROPIC
  HTTP
}

enum AiTask {
  HISTORY_SUMMARY
  VISIT_ADVICE
}

enum AiDraftStatus {
  DRAFT
  USED
  DISCARDED
}

model AiConfig {
  tenantId    String         @db.Uuid
  facilityId  String         @db.Uuid
  kind        AiProviderKind
  /// HTTP: the service address. ANTHROPIC: an optional address of a gateway in front of the API (default is the provider's own).
  url         String?
  /// ANTHROPIC: the model to ask for.
  model       String?
  apiKeyEnc   String?
  keyLast4    String?
  timeoutMs   Int            @default(30000)
  /// An administrator confirmed that sending de-identified visit data to this provider is allowed by the hospital's agreement with it.
  dataAckAt   DateTime?      @db.Timestamptz(3)
  dataAckById String?        @db.Uuid
  lastTestAt  DateTime?      @db.Timestamptz(3)
  lastTestOk  Boolean?
  lastTestMessage String?
  updatedById String         @db.Uuid
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([tenantId, facilityId])
}

/// One AI draft for one visit, kept so there is a record of what the AI wrote and what the doctor did with it. Only the review fields ever change.
model AiDraft {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  facilityId   String        @db.Uuid
  patientId    String        @db.Uuid
  encounterId  String        @db.Uuid
  task         AiTask
  status       AiDraftStatus @default(DRAFT)
  outputText   String
  inputChars   Int
  provider     String
  model        String?
  requestedById String       @db.Uuid
  requestedAt  DateTime      @default(now()) @db.Timestamptz(3)
  reviewedAt   DateTime?     @db.Timestamptz(3)
  /// The doctor changed the text before using it.
  edited       Boolean       @default(false)

  patient   Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, encounterId, requestedAt(sort: Desc)])
  @@index([tenantId, requestedById, requestedAt(sort: Desc)])
}
