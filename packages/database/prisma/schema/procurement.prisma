// ───────────────────────── procurement to consumption (docs/procurement.md) ─────────────────────────

enum IndentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  /// Every line has been put on a purchase order.
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  /// Closed before everything arrived (the supplier cannot supply the rest), with a reason.
  CLOSED
}

enum ConsumptionKind {
  /// Used for a patient's procedure (an OT consumable or implant).
  PROCEDURE
  /// Used by a department (cleaning supplies, dressings kept at the nursing station) with a reason.
  DEPARTMENT_USE
}

/// A request for stock to be bought (docs/procurement.md): raised by the pharmacy, a ward or the OT, approved by someone other than the person who asked, then put on purchase orders.
model PurchaseIndent {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @db.Uuid
  facilityId        String       @db.Uuid
  indentNumber      String
  status            IndentStatus @default(DRAFT)
  /// The place that needs the stock (a ward store, the OT store); empty for the main store.
  forLocationId     String?      @db.Uuid
  note              String?
  requestedById     String       @db.Uuid
  requestedAt       DateTime     @default(now()) @db.Timestamptz(3)
  submittedAt       DateTime?    @db.Timestamptz(3)
  decidedById       String?      @db.Uuid
  decidedAt         DateTime?    @db.Timestamptz(3)
  decisionNote      String?
  cancelledById     String?      @db.Uuid
  cancelledAt       DateTime?    @db.Timestamptz(3)
  cancelReason      String?
  /// How many people other than the requester must approve it, fixed when it is submitted from its estimated value; the first approval waits here.
  approvalsRequired Int          @default(1)
  estimatedValue    Decimal?     @db.Decimal(14, 2)
  firstApprovedById String?      @db.Uuid
  firstApprovedAt   DateTime?    @db.Timestamptz(3)

  facility    Facility             @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  forLocation StockLocation?       @relation(fields: [tenantId, forLocationId], references: [tenantId, id], onDelete: Restrict)
  items       PurchaseIndentItem[]
  orders      PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, indentNumber])
  @@index([tenantId, facilityId, status, requestedAt(sort: Desc)])
}

model PurchaseIndentItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @db.Uuid
  indentId        String  @db.Uuid
  lineNo          Int
  medicineId      String  @db.Uuid
  quantity        Int
  /// How much of this line is already on purchase orders.
  orderedQuantity Int     @default(0)
  note            String?

  indent     PurchaseIndent      @relation(fields: [tenantId, indentId], references: [tenantId, id], onDelete: Restrict)
  medicine   Medicine            @relation(fields: [tenantId, medicineId], references: [tenantId, id], onDelete: Restrict)
  orderLines PurchaseOrderItem[]

  @@unique([tenantId, id])
  @@unique([indentId, lineNo])
}

/// An order placed with a supplier. Its lines are fixed once it is issued; goods receipts are matched against it.
model PurchaseOrder {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @db.Uuid
  facilityId         String              @db.Uuid
  poNumber           String
  supplierId         String              @db.Uuid
  indentId           String?             @db.Uuid
  status             PurchaseOrderStatus @default(DRAFT)
  expectedOn         DateTime?           @db.Date
  notes              String?
  subtotal           Decimal             @db.Decimal(14, 2)
  taxTotal           Decimal             @db.Decimal(14, 2)
  total              Decimal             @db.Decimal(14, 2)
  createdById        String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  /// An order above the hospital's approval limit is approved by someone other than the person who made it before it is issued.
  approvedById       String?             @db.Uuid
  approvedAt         DateTime?           @db.Timestamptz(3)
  /// An order above the second approval limit needs a second, different approver.
  secondApprovedById String?             @db.Uuid
  secondApprovedAt   DateTime?           @db.Timestamptz(3)
  issuedById         String?             @db.Uuid
  issuedAt           DateTime?           @db.Timestamptz(3)
  closedById         String?             @db.Uuid
  closedAt           DateTime?           @db.Timestamptz(3)
  closeReason        String?

  facility Facility            @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  supplier Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  indent   PurchaseIndent?     @relation(fields: [tenantId, indentId], references: [tenantId, id], onDelete: Restrict)
  items    PurchaseOrderItem[]
  receipts Purchase[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, poNumber])
  @@index([tenantId, facilityId, status, createdAt(sort: Desc)])
}

model PurchaseOrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @db.Uuid
  orderId          String  @db.Uuid
  lineNo           Int
  medicineId       String  @db.Uuid
  indentItemId     String? @db.Uuid
  quantity         Int
  /// Accepted into stock so far, across all goods receipts.
  receivedQuantity Int     @default(0)
  rate             Decimal @db.Decimal(12, 2)
  gstPercent       Decimal @db.Decimal(5, 2)
  lineTotal        Decimal @db.Decimal(14, 2)

  order        PurchaseOrder       @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  medicine     Medicine            @relation(fields: [tenantId, medicineId], references: [tenantId, id], onDelete: Restrict)
  indentItem   PurchaseIndentItem? @relation(fields: [tenantId, indentItemId], references: [tenantId, id], onDelete: Restrict)
  receiptLines PurchaseItem[]

  @@unique([tenantId, id])
  @@unique([orderId, lineNo])
}

/// Stock used up without being sold or billed per unit: an OT consumable for a procedure, or a department's own use. It leaves the location's ledger at the batch's purchase
/// price, which is the cost posted. Never edited or deleted.
model StockConsumption {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @db.Uuid
  facilityId   String          @db.Uuid
  locationId   String          @db.Uuid
  batchId      String          @db.Uuid
  medicineId   String          @db.Uuid
  quantity     Int
  kind         ConsumptionKind
  procedureId  String?         @db.Uuid
  /// The charge on the patient's admission when the stock was billed to the patient.
  chargeId     String?         @db.Uuid
  reason       String?
  unitCost     Decimal         @db.Decimal(12, 2)
  totalCost    Decimal         @db.Decimal(14, 2)
  consumedById String          @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  location  StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  batch     MedicineBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict)
  procedure Procedure?    @relation(fields: [tenantId, procedureId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, facilityId, createdAt(sort: Desc)])
  @@index([tenantId, procedureId])
}

// ───────────────────────── store requests, rejected deliveries, supplier credit, supplier payments, stock counts ─────────────────────────

enum StockRequestStatus {
  REQUESTED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
}

enum DebitNoteStatus {
  /// Asked of the supplier for goods turned away at the quality check.
  RAISED
  /// The supplier agreed the credit (or replaced the goods): it no longer counts as owed to them.
  CREDITED
}

enum StockCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

/// A ward, the OT or another store asking the main store for stock it needs (not a request to buy: that is an indent). The store fulfils it with stock transfers.
model StockRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @db.Uuid
  facilityId    String             @db.Uuid
  requestNumber String
  locationId    String             @db.Uuid
  status        StockRequestStatus @default(REQUESTED)
  note          String?
  requestedById String             @db.Uuid
  requestedAt   DateTime           @default(now()) @db.Timestamptz(3)
  closedById    String?            @db.Uuid
  closedAt      DateTime?          @db.Timestamptz(3)
  closeReason   String?

  facility Facility           @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  items    StockRequestItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, requestNumber])
  @@index([tenantId, facilityId, status, requestedAt(sort: Desc)])
}

model StockRequestItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @db.Uuid
  requestId      String @db.Uuid
  lineNo         Int
  medicineId     String @db.Uuid
  quantity       Int
  issuedQuantity Int    @default(0)

  request  StockRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  medicine Medicine     @relation(fields: [tenantId, medicineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([requestId, lineNo])
}

/// Goods turned away at the quality check where nothing of the line was accepted (a line with some accepted units records its rejection on the purchase line itself).
model PurchaseRejection {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  purchaseId String  @db.Uuid
  lineNo     Int
  medicineId String  @db.Uuid
  poItemId   String? @db.Uuid
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  gstPercent Decimal @db.Decimal(5, 2)
  reason     String

  purchase Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Restrict)
  medicine Medicine @relation(fields: [tenantId, medicineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([purchaseId, lineNo])
}

/// What the supplier is asked to credit for rejected goods. Raised automatically when a goods receipt turns goods away; credited once the supplier agrees. Never edited or deleted.
model SupplierDebitNote {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @db.Uuid
  facilityId      String          @db.Uuid
  noteNumber      String
  purchaseId      String          @db.Uuid
  supplierId      String          @db.Uuid
  amount          Decimal         @db.Decimal(14, 2)
  reason          String
  status          DebitNoteStatus @default(RAISED)
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  creditedById    String?         @db.Uuid
  creditedAt      DateTime?       @db.Timestamptz(3)
  creditReference String?

  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  purchase Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Restrict)
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, noteNumber])
  @@index([tenantId, purchaseId])
}

/// Money paid to a supplier against one of their invoices (a goods receipt). Append-only: a wrong payment is put right with a new entry by the supplier's credit, never an edit.
model SupplierPayment {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @db.Uuid
  facilityId String        @db.Uuid
  purchaseId String        @db.Uuid
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  reference  String?
  paidOn     DateTime      @db.Date
  paidById   String        @db.Uuid
  /// The supplier payment that settled several invoices at once, if this was one of them.
  runId      String?       @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  facility Facility            @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  purchase Purchase            @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Restrict)
  run      SupplierPaymentRun? @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, purchaseId])
}

/// A physical count of the stock in one place (the main store, or a location). The counters enter what they find; someone else approves; the differences are then posted as
/// stock adjustments, so the ledger shows exactly what changed and why.
model StockCount {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @db.Uuid
  facilityId   String           @db.Uuid
  countNumber  String
  /// Empty: the main store.
  locationId   String?          @db.Uuid
  status       StockCountStatus @default(OPEN)
  note         String?
  startedById  String           @db.Uuid
  startedAt    DateTime         @default(now()) @db.Timestamptz(3)
  submittedAt  DateTime?        @db.Timestamptz(3)
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?        @db.Timestamptz(3)
  decisionNote String?

  facility Facility         @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation?   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  items    StockCountItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, countNumber])
  @@index([tenantId, facilityId, status, startedAt(sort: Desc)])
}

model StockCountItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @db.Uuid
  countId         String  @db.Uuid
  batchId         String  @db.Uuid
  medicineId      String  @db.Uuid
  /// What the system held when the count started.
  systemQuantity  Int
  countedQuantity Int?
  /// Why the count differs from the system (needed whenever it does).
  reason          String?

  count StockCount    @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Restrict)
  batch MedicineBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([countId, batchId])
}

/// One payment to a supplier that settles several of their invoices at once (a statement payment): the amount, how it was paid, and the payments it was split into.
model SupplierPaymentRun {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @db.Uuid
  facilityId String        @db.Uuid
  supplierId String        @db.Uuid
  total      Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  reference  String?
  paidOn     DateTime      @db.Date
  paidById   String        @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  facility Facility          @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  supplier Supplier          @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  payments SupplierPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, supplierId, paidOn(sort: Desc)])
}

enum JournalAccount {
  INVENTORY
  GST_INPUT
  SUPPLIER_PAYABLE
  CONSUMPTION_EXPENSE
  PURCHASE_RETURNS
  CASH
  BANK
  COST_OF_GOODS_SOLD
  STOCK_ADJUSTMENT
}

/// The cost ledger (docs/procurement.md): each stock and supplier event is posted as a balanced entry (what is debited equals what is credited), in the same transaction as the event.
/// It is not a general ledger: it covers purchases, supplier returns and credits, supplier payments and consumption. Never edited or deleted.
model JournalEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  facilityId  String   @db.Uuid
  /// What posted it, e.g. RECEIPT:<purchase id>; unique so an event is never posted twice.
  sourceKey   String
  sourceType  String
  sourceId    String   @db.Uuid
  entryDate   DateTime @db.Date
  narration   String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  facility Facility      @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  lines    JournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, facilityId, entryDate(sort: Desc)])
}

model JournalLine {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @db.Uuid
  entryId    String         @db.Uuid
  account    JournalAccount
  /// The place the cost belongs to (the main store, a ward store, the OT, a department).
  costCentre String?
  debit      Decimal        @default(0) @db.Decimal(14, 2)
  credit     Decimal        @default(0) @db.Decimal(14, 2)

  entry JournalEntry @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, entryId])
  @@index([tenantId, account])
}
