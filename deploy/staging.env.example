# STAGING settings (CLAUDE.md §50). Copy to deploy/staging.env on the staging host (git-ignored) and deploy with:
#   docker compose --env-file deploy/staging.env -f docker-compose.yml -f docker-compose.secrets.yml --profile proxy up -d --build --wait
# Staging has its own database, bucket, secrets and domain. It holds synthetic or anonymised data only: production data is never
# copied down to it. It runs the same safety checks as production (APP_ENV=staging), so a mistake shows up here first.

COMPOSE_PROJECT_NAME=medos-staging
APP_ENV=staging

SITE_ADDRESS=staging.hospital.example.org
CORS_ORIGINS=https://staging.hospital.example.org

POSTGRES_USER=medos
POSTGRES_DB=medos_staging

STORAGE_DRIVER=s3
S3_BUCKET=hospital-medos-staging-files
S3_REGION=ap-south-1
S3_PREFIX=medos/
S3_SSE=AES256

CLAMAV_HOST=clamav.internal

# Staging is where a row-level-security change is switched on first (docs/rls.md), then production
DB_TENANT_CONTEXT=off

REMINDER_PROVIDER=log
