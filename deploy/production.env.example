# PRODUCTION settings (CLAUDE.md §50). Copy to deploy/production.env on the production host (git-ignored) and deploy with:
#   docker compose --env-file deploy/production.env -f docker-compose.yml -f docker-compose.secrets.yml --profile proxy up -d --build --wait
# Production shares NOTHING with staging or development: its own database, bucket, secrets, domain and compose project.
# Secrets (database password, database URL, JWT secret, S3 keys) are NOT in this file: they live in ./secrets/ (docker-compose.secrets.yml).
# With APP_ENV=production the API refuses to start if a secret looks like a placeholder, the database is a *_dev/*_test one,
# an origin is not https, or the rate limit is off.

COMPOSE_PROJECT_NAME=medos-production
APP_ENV=production

# Public address (DNS must point at this host; ports 80 and 443 must be open)
SITE_ADDRESS=hospital.example.org
CORS_ORIGINS=https://hospital.example.org

# Database: the bundled container is fine for a small site; prefer managed PostgreSQL (then remove the "db" service and
# put its URL in secrets/database_url). Either way, back it up (docs/backup.md) and test restoring.
POSTGRES_USER=medos
POSTGRES_DB=medos_production

# Patient files in an S3-compatible bucket reserved for production, encrypted by the store (docs/storage.md)
STORAGE_DRIVER=s3
S3_BUCKET=hospital-medos-production-files
S3_REGION=ap-south-1
S3_PREFIX=medos/
S3_SSE=AES256

# Scan every upload (a ClamAV daemon must be reachable at this address); uploads are refused while it is down
CLAMAV_HOST=clamav.internal

# Row-level security: switch to "on" only after the steps in docs/rls.md (restricted login + evidence run)
DB_TENANT_CONTEXT=off

# Reminders stay log-only until an SMS gateway is wired in (docs/follow-ups.md)
REMINDER_PROVIDER=log
