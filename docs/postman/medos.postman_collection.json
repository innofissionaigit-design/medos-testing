{
  "info": {
    "name": "MedOS API (local)",
    "description": "Connectivity and workflow checks for the MedOS API. Sign in with a staff account (the default is Reception: it holds the permissions for patients, appointments, the OPD queue, admissions and billing; the Admin-only folder needs admin or the cashier). Fill the collection variable 'password' (nothing secret is stored in this file), run 'Login', and every other request uses the Bearer token it saves. The token lasts 15 minutes: run 'Refresh token' when requests return 401. These requests only read data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "tenantCode",
      "value": "demo-hospital"
    },
    {
      "key": "identifier",
      "value": "reception1"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "facilityId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "currentRoles",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Health, login (Bearer token saved automatically), who-am-I, refresh and logout.",
      "item": [
        {
          "name": "1. Health (no login needed)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Expect 200 {\"data\":{\"status\":\"ok\"}}. If this fails, the API is not running or the port is wrong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is up', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Body is exactly tenantCode, identifier (username or email) and password; extra fields are refused with 400. 200 with status AUTHENTICATED returns the tokens. If status is FACILITY_SELECTION_REQUIRED, put one of the listed facility ids in the facilityId variable and use 'Login (choose facility)'. Wrong credentials give 401 INVALID_CREDENTIALS. Login is limited to 10 attempts a minute per address."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Login answered 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 && j.data.status === 'AUTHENTICATED') {",
                  "  pm.collectionVariables.set('accessToken', j.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.data.tokens.refreshToken);",
                  "  pm.test('Token saved', () => pm.expect(pm.collectionVariables.get('accessToken')).to.be.a('string').and.not.empty);",
                  "} else if (pm.response.code === 200) {",
                  "  console.log('Choose a facility:', JSON.stringify(j.data.facilities));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Login with a facility (only if Login asked you to choose one)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\",\n  \"facilityId\": \"{{facilityId}}\"\n}"
            },
            "description": "Only needed when 'Login' answers FACILITY_SELECTION_REQUIRED: copy one facility id from that answer into the facilityId variable, then run this. Skip it otherwise."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not needed unless Login asked for a facility: skip the request instead of sending a login that would be refused.",
                  "if (!pm.variables.get('facilityId') && pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('facilityId')) { pm.test('Skipped: no facility needed', () => pm.expect(true).to.eql(true)); } else {",
                  "  const j = pm.response.json();",
                  "  if (pm.response.code === 200 && j.data && j.data.status === 'AUTHENTICATED') {",
                  "    pm.collectionVariables.set('accessToken', j.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', j.data.tokens.refreshToken);",
                  "  }",
                  "  pm.test('Authenticated', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Who am I (needs the token)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Expect 200. Without a token, or with 'Authorization' not starting with 'Bearer ', the answer is 401 UNAUTHENTICATED: that is the API working as designed, not a fault."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated request works', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Refresh token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Swaps the refresh token for a new pair (the old refresh token stops working). Run this when requests start returning 401 after 15 minutes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  const t = j.data.tokens || j.data;",
                  "  pm.collectionVariables.set('accessToken', t.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "}",
                  "pm.test('Refreshed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Logout (revokes the refresh token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out (204)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
