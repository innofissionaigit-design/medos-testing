    {
      "name": "Admin only",
      "description": "These three requests are role-aware. Administrator can open all three; Manager and Cashier can open the two reports (not OCR settings); Receptionist and other roles are refused with 403 FORBIDDEN, and the tests expect that. Sign in as admin (set identifier in the environment) to see 200 on all three.",
      "item": [
        {
          "name": "Registrations report (today)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/registrations"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ask the API who is signed in, so the test below knows which answer to expect.",
                  "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/auth/me', method: 'GET', header: { Authorization: 'Bearer ' + pm.variables.get('accessToken') } }, (err, res) => {",
                  "  const j = !err && res && res.code === 200 ? res.json() : null;",
                  "  pm.collectionVariables.set('currentRoles', j && j.data && j.data.roles ? j.data.roles.join(',') : '');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// needs REPORT_READ or REPORT_FINANCE. Allowed roles: ADMINISTRATOR, MANAGER, CASHIER. Every other role, Receptionist included, must be refused.",
                  "const roles = (pm.collectionVariables.get('currentRoles') || '').split(',').filter(Boolean);",
                  "const allowed = [\"ADMINISTRATOR\",\"MANAGER\",\"CASHIER\"];",
                  "pm.test('The signed-in role is known', () => pm.expect(roles.length > 0).to.eql(true));",
                  "const permitted = roles.some((x) => allowed.indexOf(x) >= 0);",
                  "const expected = permitted ? 200 : 403;",
                  "pm.test('As ' + roles.join('/') + ' the answer is ' + expected, () => pm.response.to.have.status(expected));",
                  "if (permitted) { pm.test('The answer carries data', () => pm.expect(typeof pm.response.json().data).to.eql('object')); }",
                  "else { pm.test('Refused as FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Collections report (today)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/collections"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
