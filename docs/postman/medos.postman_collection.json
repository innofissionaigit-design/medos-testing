  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request: signs in again when the token is missing or about to expire, and picks a patient when patientId is empty.",
          "const v = (k) => pm.variables.get(k);",
          "const noAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (!noAuth) {",
          "  const tokenOk = () => { try { const t = v('accessToken'); if (!t) return false; const p = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); return p.exp * 1000 > Date.now() + 30000; } catch (e) { return false; } };",
          "  const base = v('baseUrl');",
          "  const signIn = (done) => {",
          "    if (tokenOk() || !v('password')) return done();",
          "    pm.sendRequest({ url: base + '/auth/login', method: 'POST', header: { 'Content-Type': 'application/json' },",
          "      body: { mode: 'raw', raw: JSON.stringify({ tenantCode: v('tenantCode'), identifier: v('identifier'), password: v('password'), facilityId: v('facilityId') || undefined }) } }, (err, res) => {",
          "      const j = !err && res && res.code === 200 ? res.json() : null;",
          "      if (j && j.data && j.data.status === 'AUTHENTICATED') { pm.collectionVariables.set('accessToken', j.data.tokens.accessToken); pm.collectionVariables.set('refreshToken', j.data.tokens.refreshToken); }",
          "      done();",
          "    });",
          "  };",
          "  const pickPatient = () => {",
          "    if (v('patientId') || JSON.stringify(pm.request.url).indexOf('patientId') < 0) return;",
          "    pm.sendRequest({ url: base + '/patients?q=DEMO&pageSize=1', method: 'GET', header: { Authorization: 'Bearer ' + v('accessToken') } }, (err, res) => {",
          "      const j = !err && res && res.code === 200 ? res.json() : null;",
          "      if (j && j.data && j.data[0]) { pm.collectionVariables.set('patientId', j.data[0].id); }",
          "    });",
          "  };",
          "  signIn(pickPatient);",
          "}"
        ]
      }
    }
  ]
}
