# Copy to .env (never commit .env). Every value below is a placeholder.

# ── local development (Windows cluster started by scripts/db-up.ps1) ──
DATABASE_URL=postgresql://medos@127.0.0.1:54329/medos_dev
TEST_DATABASE_URL=postgresql://medos@127.0.0.1:54329/medos_test

# ── API ──
PORT=4000
# 32+ random characters, different per environment:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxxx
CORS_ORIGINS=http://localhost:3000
# Which environment this is: local (default), staging or production. The last two refuse to start with development secrets,
# a *_dev/*_test database, localhost or http:// origins, or the rate limit off (see deploy/*.env.example, docs/deployment.md).
APP_ENV=local
# Any of DATABASE_URL, JWT_ACCESS_SECRET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY can instead be given as <NAME>_FILE=/path
# to a file holding the value (Docker and Kubernetes secrets); see docker-compose.secrets.yml.
# Password hashing (Argon2id). The defaults are the OWASP minimum and are what production requires; lower them only for tests.
# ARGON2_MEMORY_KIB=19456
# ARGON2_PASSES=2
# Patient files: "local" (STORAGE_DIR on this machine; one API instance) or "s3" (any S3-compatible store, docs/storage.md).
STORAGE_DRIVER=local
# S3_BUCKET=medos-files
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com   # leave unset for AWS; set for R2, Ceph, SeaweedFS…
# S3_FORCE_PATH_STYLE=false                          # true for most self-hosted stores
# S3_PREFIX=medos/prod/                              # optional folder inside the bucket, ending with a slash
# S3_ACCESS_KEY_ID=…                                 # leave both unset to use the machine's own credentials (e.g. an IAM role)
# S3_SECRET_ACCESS_KEY=…
# S3_SSE=AES256                                      # or aws:kms (with S3_KMS_KEY_ID) to have the store encrypt every file
# Peers allowed to report the browser's address in X-Forwarded-For (Express "trust proxy" syntax). Locally the web server
# reaches the API over loopback; in Docker it is the compose network (uniquelocal). "false" trusts nobody.
TRUST_PROXY=loopback
# Where login / token-refresh / password-change request counters live. "database" (default) shares one allowance across every
# API instance; "memory" counts per process and is only right for a single instance.
RATE_LIMIT_STORE=database
# Row-level security (docs/rls.md). Leave "off" until the API uses the restricted medos_app login (phase 3).
DB_TENANT_CONTEXT=off
# Development and tests ONLY (refused in production): act as this role inside every transaction to prove the policies hold.
# DB_SESSION_ROLE=medos_app
# Virus scan of uploaded patient files through a ClamAV daemon (clamd, TCP). Leave CLAMAV_HOST unset in local development
# (nothing is scanned). Once set, every upload is scanned and uploads are refused while the scanner is unreachable.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000
# Follow-up reminders (docs/follow-ups.md). "log" records reminders and logs them WITHOUT sending any SMS.
REMINDER_PROVIDER=log
# Booking payment links (docs/booking-payment-link.md). "log" is a placeholder: nothing is sent on WhatsApp.
PAYMENT_LINK_PROVIDER=log
# Encrypts API keys that administrators save in the app (the OCR service key). Base64 of 32 random bytes: openssl rand -base64 32
# Keep it secret and backed up separately from the database; without it saved keys cannot be read.
SECRETS_ENCRYPTION_KEY=
# Handwritten prescriptions (docs/prescriptions.md). Administrators can also connect the service in Settings. "none" stores uploads and lets the doctor type the text.
# With "http" the image is sent to OCR_API_URL; it contains patient information, so use a provider you are permitted to share it with.
OCR_PROVIDER=none
# OCR_API_URL=https://ocr.example.com/read
# OCR_API_KEY=
OCR_TIMEOUT_MS=15000
# Requests per minute allowed for one API key (docs/integration-api.md).
API_CLIENT_RATE_LIMIT_PER_MINUTE=120
PAYMENT_LINK_BASE_URL=https://pay.example.invalid/booking
REMINDER_WORKER_ENABLED=true
REMINDER_POLL_SECONDS=60

# ── docker compose ──
POSTGRES_USER=medos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medos
# Use URL-safe characters (e.g. `openssl rand -hex 24`): the password is placed inside DATABASE_URL.
# HTTPS: the public host name for `docker compose --profile proxy up` (Caddy gets the certificate; DNS must point here).
# SITE_ADDRESS=hospital.example.org
# Open the web app on the network without the proxy (local demos only):
# WEB_BIND=0.0.0.0

# ── web ──
# The web app's server side calls the API at API_URL (never the browser). Default shown; docker compose sets it to the api service.
# API_URL=http://127.0.0.1:4000/api/v1

# -- messages to patients, such as the prescription link (docs/prescriptions.md) --
# "log" records what would be sent and sends nothing. "http" posts each message to MESSAGE_API_URL (MESSAGE_API_KEY is sent as a bearer token).
MESSAGE_PROVIDER=log
# MESSAGE_API_URL=https://messages.example.com/send
# MESSAGE_API_KEY=

# Email to patients (docs/email.md). "log" records what would be sent and sends nothing. "http" posts each email to EMAIL_API_URL (EMAIL_API_KEY is sent as a bearer token)
# and needs EMAIL_FROM_ADDRESS, the sender address your email service has verified (SPF, DKIM and DMARC are set up in DNS).
EMAIL_PROVIDER=log
# EMAIL_API_URL=https://mail.example.com/send
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=no-reply@your-hospital.example
# The website's public address, used in the links sent to patients (defaults to the first CORS origin).
# PUBLIC_WEB_URL=https://hospital.example.com
